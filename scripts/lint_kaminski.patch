+        dash_flags = [bool(re.search(r"\s[—–]\s", s)) for s in sents]
+        dash_total = sum(dash_flags)
+        dash_run = max_dash_run = 0
+        for df in dash_flags:
+            dash_run = dash_run + 1 if df else 0
+            max_dash_run = max(max_dash_run, dash_run)
